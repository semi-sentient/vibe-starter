{
	"name": "vibe-starter",
	"version": "1.0.0",
	"description": "An opinionated, MIT-licensed full-stack TypeScript starter template.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "npm run build:web && npm run build:server",
		"build:server": "tsup src/server/index.ts --format esm --out-dir dist-server --clean",
		"build:web": "vite build",
		"dev": "concurrently -k -n web,api -c blue,green \"vite\" \"tsx watch --env-file-if-exists=.env src/server/index.ts\""
	},
	"dependencies": {
		"@hono/node-server": "^2.0.4",
		"@tanstack/react-query": "^5.101.0",
		"hono": "^4.12.23",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^7.16.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"concurrently": "^10.0.3",
		"tsup": "^8.5.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
